# GHL DevOps Toolkit - Environment Variables
# Copy this file to `.env` and adjust values.
# NEVER commit your real .env file.

# Database
# Default: SQLite file (zero-config local dev)
DATABASE_URL="file:./db/custom.db"

# For PostgreSQL (production), use:
# DATABASE_URL="postgresql://user:password@localhost:5432/ghl_devops?schema=public"

# AI Providers (optional - the AI Debugger works with the bundled z-ai-web-dev-sdk)
# Used when calling Gemini directly
GEMINI_API_KEY=""

# Used when routing through OpenRouter
OPENROUTER_API_KEY=""

# Toolkit configuration (also configurable in-app via Settings)
# Demo mode returns simulated GHL responses without making network calls
DEMO_MODE="true"

# Webhook signature secret (also configurable in-app)
WEBHOOK_SECRET=""

# Audit logging
AUDIT_LOGGING="true"
